<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout del formulario de usuario (P29). Solo ADMIN.

    Orden de campos:
      btnEditarEmpleado (solo modo edicion + rol != ADMIN),
      tilRol (primero, controla el resto), tilUsername (auto-sugerido segun rol),
      tvFechaCreacion (solo edicion), tilPassword (solo alta), tilEmail,
      seccion perfil empleado (solo alta si rol != ADMIN), btnCambiarPassword,
      btnCambiarEstado, btnGuardar.

    Modo alta   (usuarioId=-1): tilRol, tilUsername, tilPassword, tilEmail,
                                seccion perfil empleado, btnGuardar.
    Modo edicion (usuarioId>0): tilRol, tilUsername (disabled), tvFechaCreacion,
                                tilEmail, btnCambiarPassword, btnCambiarEstado,
                                btnGuardar.
                                Cabecera "Empleado: Nombre Apellidos (EMP-XXX)"
                                como TextButton con icono de lapiz que abre P14
                                — solo si el usuario tiene empleado asociado.
                                Simetrico al boton "Usuario: {username}" de P14.

    tilPassword solo visible en modo alta.
    btnCambiarPassword solo visible en modo edicion: abre dialogo con campo
    de contrasena nueva (minimo 8 chars) y llama a E66 PATCH /usuarios/{id}/password.
    Seccion perfil empleado solo visible en modo alta (en edicion se gestiona desde P14/P15).
    btnCambiarEstado solo visible en modo edicion: alterna entre "Desactivar"
    (rojo, llama a E12 DELETE) y "Activar" (verde, llama a E67 PATCH /reactivar)
    segun usuario.activo. Patron simetrico al de DetalleEmpleadoFragment (P15).
    Acciones secundarias (btnCambiarPassword, btnCambiarEstado) wrap_content
    centradas; btnGuardar es la accion primaria y ocupa el ancho completo.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!--
            Cabecera read-only del empleado asociado (solo modo edicion,
            solo rol != ADMIN). MaterialButton.TextButton con el texto
            "Empleado: Nombre (EMP-XXX)" y un icono de lapiz a la derecha
            que indica que abre P14 DetalleEmpleadoFragment para editar
            al empleado. Alineado a la izquierda y sin botones extra al
            lado para que quede claro a que entidad se refiere la accion.

            Simetrico al boton "Usuario: {username}" de la cabecera de P14:
            ambas pantallas usan el mismo patron (TextButton + icono lapiz
            + colorPrimary) para saltar a la edicion de la entidad opuesta.

            Visibility=gone por defecto; el Fragment lo hace visible al
            recibir un CabeceraEmpleado != null (pintarCabeceraEmpleado).
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditarEmpleado"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginBottom="16dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="?attr/colorPrimary"
            app:icon="@drawable/ic_edit_24"
            app:iconGravity="textEnd"
            app:iconTint="?attr/colorPrimary"
            android:visibility="gone" />

        <!--
            Rol primero: marca el contexto del formulario y dispara la
            sugerencia de username segun el prefijo (emp/encargado/admin).
            Tambien controla la visibilidad de la seccion de perfil empleado.
        -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRol"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/form_usuario_hint_rol">

            <AutoCompleteTextView
                android:id="@+id/actvRol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:focusableInTouchMode="false" />

        </com.google.android.material.textfield.TextInputLayout>

        <!--
            Username: NO editable a mano. En modo alta se auto-rellena con
            el prefijo del rol (empXX, encargadoXX, adminXX) calculado por
            FormUsuarioViewModel.sugerirUsername. En modo edicion queda
            disabled (el backend no admite cambiar username via PATCH).
            Por eso el EditText es no focusable: la unica via de obtener
            valor es la sugerencia del ViewModel.
        -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilUsername"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/form_usuario_hint_username">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:inputType="none"
                android:autofillHints="username" />

        </com.google.android.material.textfield.TextInputLayout>

        <!--
            Fecha de creacion del usuario (solo lectura).
            Visible unicamente en modo edicion; en modo alta queda gone por defecto.
            Se rellena al recibir SuccessAlta con el usuario cargado.
        -->
        <TextView
            android:id="@+id/tvFechaCreacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <!-- Password (solo en modo alta) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/form_usuario_hint_password"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:autofillHints="password" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Email -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/form_usuario_hint_email">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress" />

        </com.google.android.material.textfield.TextInputLayout>

        <!--
            Seccion "Perfil de empleado".
            Visible en modo alta cuando rol != ADMIN.
            Oculta en modo edicion (el perfil se edita desde P14/P15).
        -->
        <LinearLayout
            android:id="@+id/layoutPerfilEmpleado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/form_usuario_seccion_perfil"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="12dp" />

            <!-- Nombre -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNombre"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/form_empleado_hint_nombre">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Primer apellido -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilApellido1"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/form_empleado_hint_apellido1">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etApellido1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Segundo apellido (opcional) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilApellido2"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/form_empleado_hint_apellido2">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etApellido2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- DNI -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDni"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/form_empleado_hint_dni">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDni"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Categoria (dropdown) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCategoria"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/form_empleado_hint_categoria">
                <AutoCompleteTextView
                    android:id="@+id/actvCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:focusableInTouchMode="false" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Horas semanales -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilJornadaSemanal"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/form_empleado_hint_jornada_semanal">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etJornadaSemanal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Dias de vacaciones -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilVacaciones"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/form_empleado_hint_vacaciones">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etVacaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Dias de asuntos propios -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAsuntos"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/form_empleado_hint_asuntos">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAsuntos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!--
                Fecha de alta del empleado (primer dia de trabajo).
                Editable solo en modo alta. Default precargado a hoy.
                Permite fechas futuras (altas diferidas), no anteriores a hoy.
                Se abre MaterialDatePicker al hacer click; el EditText es no focusable.
            -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFechaAlta"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/form_usuario_hint_fecha_alta"
                app:endIconMode="custom"
                app:endIconDrawable="@android:drawable/ic_menu_my_calendar">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFechaAlta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:inputType="none"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!--
            Boton para cambiar la contrasena del usuario (solo modo edicion).
            Al pulsarlo se abre un dialogo con campo de contrasena nueva.
            wrap_content centrado para no ocupar todo el ancho (accion secundaria,
            no destructiva). Llama a E66 PATCH /usuarios/{id}/password.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCambiarPassword"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:text="@string/form_usuario_cambiar_password"
            android:visibility="gone" />

        <!--
            Boton para cambiar el estado activo (solo en modo edicion).
            Texto y color se reasignan en runtime (Fragment.observarViewModel) segun
            usuario.activo: "Desactivar" rojo si activo=true, "Activar" verde si false.
            wrap_content centrado (mismo tamaño que btnCambiarPassword) por ser
            accion secundaria; btnGuardar es la accion primaria y ocupa el ancho.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCambiarEstado"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:text="@string/form_usuario_desactivar"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            app:strokeColor="?attr/colorError" />

        <!-- Boton guardar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/form_usuario_guardar" />

        <!-- Indicador de progreso -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:trackCornerRadius="4dp" />

    </LinearLayout>

</ScrollView>
