<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout del formulario de empleado (P15). Solo edicion.

    Patron F - formulario edit. Solo accesible para ADMIN.
    Endpoint: E16 PATCH /empleados/{id}. La precarga inicial usa E15.

    El alta de empleado se hace siempre desde P29 (FormUsuarioFragment) en el
    mismo flujo que el alta de usuario. P15 no expone modo "crear".

    Campos editables: dni, fechaAlta, nombre, apellido1, apellido2, categoria,
    jornadaSemanalHoras, diasVacaciones, diasAsuntos. La cabecera read-only
    (numeroEmpleado, usuario, email, rol) es solo informativa y se rellena
    desde E15 para que el ADMIN identifique de un vistazo a quien pertenece
    la ficha. El alta de empleado se hace siempre desde P29 (FormUsuario-
    Fragment) en el mismo flujo que el alta de usuario. numeroEmpleado se
    autogenera EMP-XXX y no es editable. El PIN se regenera desde P14 (E65).

    El boton GUARDAR se deshabilita durante la llamada al API.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!--
            Cabecera read-only: identifica la ficha sin ocupar espacio editable.
            Se rellena en prerellenarCampos() a partir de E15 (campos numero-
            Empleado, username, email y rol del EmpleadoResponse).
            Reutiliza el patron item_saldo_fila ya usado en P14 DetalleEmpleado.
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCabecera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <include
                    android:id="@+id/filaNumeroEmpleado"
                    layout="@layout/item_ficha_fila" />
                <include
                    android:id="@+id/filaUsuario"
                    layout="@layout/item_ficha_fila" />
                <include
                    android:id="@+id/filaEmail"
                    layout="@layout/item_ficha_fila" />
                <include
                    android:id="@+id/filaRol"
                    layout="@layout/item_ficha_fila" />
                <!--
                    Fecha de alta: por ahora read-only dentro de la cabecera.
                    En el proximo commit pasa a editable con MaterialDatePicker
                    y sale de la cabecera al cuerpo del formulario.
                -->
                <include
                    android:id="@+id/filaFechaAlta"
                    layout="@layout/item_ficha_fila" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Nombre -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNombre"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_empleado_hint_nombre"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:imeOptions="actionNext"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Primer apellido -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilApellido1"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_empleado_hint_apellido1"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etApellido1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:imeOptions="actionNext"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Segundo apellido (opcional) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilApellido2"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_empleado_hint_apellido2"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etApellido2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:imeOptions="actionNext"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Categoria: ExposedDropdownMenu -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCategoria"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_empleado_hint_categoria"
            android:layout_marginBottom="12dp">

            <AutoCompleteTextView
                android:id="@+id/actvCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Jornada semanal en horas -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilJornadaSemanal"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_empleado_hint_jornada_semanal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etJornadaSemanal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:imeOptions="actionNext"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Dias de vacaciones -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilVacaciones"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_empleado_hint_vacaciones"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVacaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:imeOptions="actionNext"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Dias de asuntos propios -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAsuntos"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_empleado_hint_asuntos"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAsuntos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:imeOptions="actionNext"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Boton GUARDAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/form_empleado_guardar" />

        <!-- Indicador de carga -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:indeterminate="true" />

    </LinearLayout>
</ScrollView>
