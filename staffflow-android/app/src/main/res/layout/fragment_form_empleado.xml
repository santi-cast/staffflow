<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout del formulario de empleado (P15). Solo edicion.

    Patron F - formulario edit. Solo accesible para ADMIN.
    Endpoint: E16 PATCH /empleados/{id}. La precarga inicial usa E15.

    Campos editables: nombre, apellido1, apellido2, dni (max 9 chars, 409 si
    ya existe en otro empleado), categoria, jornadaSemanalHoras, diasVacaciones,
    diasAsuntos, fechaAlta (MaterialDatePicker sin restriccion de rango: el
    ADMIN puede corregir tanto fechas pasadas como futuras).

    La cabecera read-only (numeroEmpleado, usuario, email, rol) es solo informativa
    y se rellena desde E15 para que el ADMIN identifique de un vistazo a quien
    pertenece la ficha. numeroEmpleado se autogenera EMP-XXX y no es editable.
    El PIN se regenera desde P14 (E65). El alta de empleado se hace siempre
    desde P29 (FormUsuarioFragment) en el mismo flujo que el alta de usuario.

    El boton GUARDAR se deshabilita durante la llamada al API.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!--
            Cabecera read-only: identifica la ficha sin ocupar espacio editable.
            Se rellena en prerellenarCampos() a partir de E15 (campos numero-
            Empleado, username, email y rol del EmpleadoResponse).
            Patron item_ficha_fila (label + valor en linea).
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCabecera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <include
                    android:id="@+id/filaNumeroEmpleado"
                    layout="@layout/item_ficha_fila" />
                <include
                    android:id="@+id/filaUsuario"
                    layout="@layout/item_ficha_fila" />
                <include
                    android:id="@+id/filaEmail"
                    layout="@layout/item_ficha_fila" />
                <include
                    android:id="@+id/filaRol"
                    layout="@layout/item_ficha_fila" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Nombre -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNombre"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_empleado_hint_nombre"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:imeOptions="actionNext"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Primer apellido -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilApellido1"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_empleado_hint_apellido1"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etApellido1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:imeOptions="actionNext"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Segundo apellido (opcional) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilApellido2"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_empleado_hint_apellido2"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etApellido2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:imeOptions="actionNext"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!--
            DNI editable. Validacion en cliente: longitud 9 y no vacio. El
            backend valida unicidad (409 si ya existe en otro empleado) y la
            letra de control; el cliente no duplica esa logica.
        -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDni"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_empleado_hint_dni"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDni"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:maxLength="9"
                android:imeOptions="actionNext"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Categoria: ExposedDropdownMenu -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCategoria"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_empleado_hint_categoria"
            android:layout_marginBottom="12dp">

            <AutoCompleteTextView
                android:id="@+id/actvCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Jornada semanal en horas -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilJornadaSemanal"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_empleado_hint_jornada_semanal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etJornadaSemanal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:imeOptions="actionNext"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Dias de vacaciones -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilVacaciones"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_empleado_hint_vacaciones"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVacaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:imeOptions="actionNext"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Dias de asuntos propios -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAsuntos"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_empleado_hint_asuntos"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAsuntos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:imeOptions="actionNext"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!--
            Fecha de alta del empleado. Editable via MaterialDatePicker (el
            EditText es no focusable para forzar el dialogo). Sin restriccion
            de rango: el ADMIN puede corregir tanto fechas pasadas como futuras
            (por ejemplo, "iba a empezar manana pero le puse hoy"). El backend
            (E16) acepta cualquier fecha al editar.

            Triple red de seguridad porque el cambio afecta a los informes
            historicos (M-037 en MEJORAS_V2):
              1. helperText permanente "Cambiarla afecta a los informes
                 historicos" visible bajo el campo antes de tocar nada.
              2. Dialogo de confirmacion al CERRAR el picker con una fecha
                 distinta a la actual (ver confirmarCambioFechaAlta en el
                 Fragment). Cancelar descarta la seleccion del picker.
              3. Dialogo final del GUARDAR vuelve a listar el cambio en el
                 resumen "antes -> despues" con nota especial bajo la fila
                 de fecha de alta (ver construirResumenCambios en el ViewModel).
        -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFechaAlta"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_empleado_hint_fecha_alta"
            app:helperText="@string/form_empleado_helper_fecha_alta"
            app:helperTextTextAppearance="@style/TextAppearance.Material3.BodySmall"
            android:layout_marginBottom="12dp"
            app:endIconMode="custom"
            app:endIconDrawable="@android:drawable/ic_menu_my_calendar">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFechaAlta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:inputType="none"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Boton GUARDAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/form_empleado_guardar" />

        <!-- Indicador de carga -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:indeterminate="true" />

    </LinearLayout>
</ScrollView>
