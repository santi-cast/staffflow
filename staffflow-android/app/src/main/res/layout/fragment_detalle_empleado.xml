<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout del detalle de un empleado (P14).

    Patron C - dato unico, solo lectura con acciones.
    Endpoint: E15 GET /empleados/{id}

    Tres estados gestionados por visibilidad:
      CARGANDO -> progressIndicator visible, resto GONE
      ERROR    -> layoutError visible, resto GONE
      EXITO    -> scrollContenido visible, resto GONE

    Secciones de datos:
      Header:   nombre completo + numero empleado + badge activo/inactivo
                + boton bimodal Desactivar/Activar a la derecha del badge
                en la misma fila (solo ADMIN, E17/E18). Estado y accion
                quedan visualmente ligados. El boton cambia de texto y
                color segun el estado actual:
                  Activo   -> "Desactivar" (rojo) llama a E17 PATCH /empleados/{id}/baja
                  Inactivo -> "Activar"    (verde) llama a E18 PATCH /empleados/{id}/reactivar
                El backend mantiene el termino "baja" en la URL por
                compatibilidad de la API publicada; la UI adopta
                "desactivar/activar" por cubrir mas casos (excedencias,
                bajas medicas, permisos sin sueldo).
                Debajo de la fila numero/estado/desactivar, un TextButton
                "Usuario: {username}" con icono de lapiz a la derecha
                navega a P29 FormUsuarioFragment para editar el usuario
                asociado. Alineado a la izquierda (layout_gravity=start)
                para que quede claro que se refiere al usuario y no al
                empleado (que es lo que tiene el boton Desactivar/Activar
                arriba). Visible solo para ADMIN y solo si el empleado
                tiene usuario asociado con username no nulo (E15 lo trae
                cuando llama un ADMIN; ENCARGADO recibe username=null por
                Opcion A y por eso se oculta tambien por dato). Simetrico
                al boton "Editar empleado" de la cabecera de P29.
      Datos:    DNI, fecha de alta, categoria
      Jornada:  horas semanales, dias vacaciones, dias asuntos propios
      Acciones: chips Assist "Ver saldo", "Ver fichajes", "Ver ausencias",
                "Editar empleado" y "Regenerar PIN". Texto en colorPrimary
                (morado del theme Material 3) para destacar las acciones,
                stroke negro para que el borde contraste contra el fondo
                de la tarjeta y esquinas a 20dp alineadas con el corner
                radius del boton "Editar empleado" de P29 FormUsuarioFragment.
                Editar visible solo para ADMIN.
                Regenerar PIN visible para ADMIN y ENCARGADO. Si el
                empleado esta inactivo, el chip Regenerar PIN se
                deshabilita (no tiene sentido regenerar PIN de un
                empleado que no puede fichar).
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ESTADO: CARGANDO -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="visible" />

    <!-- ESTADO: ERROR -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☁"
            android:textSize="64sp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/tvErrorMensaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReintentar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/reintentar" />

    </LinearLayout>

    <!-- ESTADO: EXITO -->
    <ScrollView
        android:id="@+id/scrollContenido"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card: Header - nombre + numero + badge activo -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvNombreCompleto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:id="@+id/tvNumeroEmpleado"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvEstado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <!--
                            Boton bimodal Desactivar/Activar (E17/E18).
                            Visible solo para ADMIN (gating en Fragment).
                            Compacto y a la derecha del estado en la misma
                            fila para que estado + accion queden ligados
                            visualmente. Texto y color dinamicos segun
                            empleado.activo:
                              activo=true  -> "Desactivar" rojo
                              activo=false -> "Activar"    verde
                        -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCambiarEstado"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:textSize="12sp"
                            android:visibility="gone" />

                    </LinearLayout>

                    <!--
                        Boton "Usuario: {username}" con icono de lapiz a la
                        derecha. Navega a P29 FormUsuarioFragment para editar
                        el usuario asociado. Simetrico al boton "Editar
                        empleado" de la cabecera de P29.

                        Alineado a la izquierda para que no se confunda con
                        el boton Desactivar/Activar de arriba (que se refiere
                        al empleado, no al usuario).

                        Visible solo si rol=ADMIN y empleado.username != null
                        (gating en Fragment.aplicarGatingPorRol).
                    -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditarUsuario"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginTop="4dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:textColor="?attr/colorPrimary"
                        app:icon="@drawable/ic_edit_24"
                        app:iconGravity="textEnd"
                        app:iconTint="?attr/colorPrimary"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Datos personales -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Datos personales"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:layout_marginBottom="8dp" />

                    <include layout="@layout/item_saldo_fila" android:id="@+id/filaDni" />
                    <include layout="@layout/item_saldo_fila" android:id="@+id/filaFechaAlta" />
                    <include layout="@layout/item_saldo_fila" android:id="@+id/filaCategoria" />
                    <include layout="@layout/item_saldo_fila"
                        android:id="@+id/filaEmail"
                        android:visibility="gone" />
                    <include layout="@layout/item_saldo_fila"
                        android:id="@+id/filaPinTerminal"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Jornada y dias -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jornada"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:layout_marginBottom="8dp" />

                    <include layout="@layout/item_saldo_fila" android:id="@+id/filaJornadaSemanal" />
                    <include layout="@layout/item_saldo_fila" android:id="@+id/filaJornadaDiaria" />
                    <include layout="@layout/item_saldo_fila" android:id="@+id/filaVacaciones" />
                    <include layout="@layout/item_saldo_fila" android:id="@+id/filaAsuntosPropios" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Acciones rapidas -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Acciones"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipVerSaldo"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detalle_empleado_ver_saldo"
                            android:textColor="?attr/colorPrimary"
                            app:chipCornerRadius="20dp"
                            app:chipStrokeColor="@color/black" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipVerFichajes"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detalle_empleado_ver_fichajes"
                            android:textColor="?attr/colorPrimary"
                            app:chipCornerRadius="20dp"
                            app:chipStrokeColor="@color/black" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipVerAusencias"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detalle_empleado_ver_ausencias"
                            android:textColor="?attr/colorPrimary"
                            app:chipCornerRadius="20dp"
                            app:chipStrokeColor="@color/black" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipEditar"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detalle_empleado_chip_editar"
                            android:textColor="?attr/colorPrimary"
                            app:chipCornerRadius="20dp"
                            app:chipStrokeColor="@color/black" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipRegenerarPin"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detalle_empleado_chip_regenerar_pin"
                            android:textColor="?attr/colorPrimary"
                            app:chipCornerRadius="20dp"
                            app:chipStrokeColor="@color/black" />

                    </com.google.android.material.chip.ChipGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
