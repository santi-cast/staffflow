<?xml version="1.0" encoding="utf-8"?>
<!--
    Background del icono adaptive de StaffFlow.

    Fondo blanco con borde violeta sutil:
      - Rectangulo blanco que cubre todo el viewport (108x108).
      - Rectangulo redondeado con borde violeta de 1.5 unidades, margen
        de 6 al canto, para destacar el icono cuando el launcher tiene
        fondo blanco.

    El viewport 108x108 es el estandar Android para adaptive icons.
    Cuando el sistema aplica la mascara (squircle, circulo, etc.) el
    borde violeta queda RECORTADO por esa mascara, lo que es deliberado:
    el contorno acompaña la forma elegida por el launcher.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Fondo blanco -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M0,0 H108 V108 H0 Z" />

    <!-- Borde violeta sutil: rectangulo redondeado con stroke -->
    <path
        android:strokeColor="#6750A4"
        android:strokeWidth="1.0"
        android:fillColor="#00000000"
        android:pathData="M26,6 H82 Q102,6 102,26 V82 Q102,102 82,102 H26 Q6,102 6,82 V26 Q6,6 26,6 Z" />
</vector>
